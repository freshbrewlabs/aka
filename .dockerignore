# The aka-admin image builds from the repo root (admin-api depends on aka's own
# crates), so the context has to stay lean: nothing the image regenerates
# itself, and nothing that is not source.
.git
**/target
**/dist
**/*.log
.env
*.env
.aka-dev
.aka.toml
# the deploy chart (incl. values-production.yaml.enc) must not ship in the site
src/public/helm
