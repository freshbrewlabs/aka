#!/usr/bin/env bash
# Push secrets/secrets.json (see bin/decrypt) into the freshbrewlabs org's
# Woodpecker secrets. Default event scope excludes pull_request (registry creds
# are only consumed by tag-event builds); an entry may override with an
# "events" key — slack_webhook needs pull_request because after-specs runs there.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/../../.."

command -v jq >/dev/null || { echo "jq is required for this script"; exit 1; }
command -v woodpecker-cli >/dev/null || { echo "woodpecker-cli is required for this script"; exit 1; }

if ! woodpecker-cli info >/dev/null 2>&1; then
  echo 'Please set $WOODPECKER_SERVER and $WOODPECKER_TOKEN, then run:'
  echo 'woodpecker-cli setup --server $WOODPECKER_SERVER --token $WOODPECKER_TOKEN'
  exit 1
fi

[ -f secrets/secrets.json ] || { echo "secrets/secrets.json missing; run bin/decrypt"; exit 1; }

jq -r '.secrets[] | to_entries as $e
       | ([$e[] | select(.key == "events") | .value][0]
          // "cron,deployment,manual,push,release,tag") as $ev
       | $e[] | select(.key != "events")
       | [.key, .value, $ev] | @tsv' secrets/secrets.json |
while IFS=$'\t' read -r key val events; do
    echo "Removing secret $key"
    woodpecker-cli org secret rm --org freshbrewlabs --name "$key" || true

    echo "Adding secret $key ($events)"
    woodpecker-cli org secret add --org freshbrewlabs --name "$key" --value "$val" \
      --event "$events"

    echo "---------"
done
